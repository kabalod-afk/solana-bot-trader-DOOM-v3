SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=TU_HELIUS_KEY
SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=TU_HELIUS_KEY
JITO_ENGINE_URL=https://mainnet.block-engine.jito.wtf
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# Opción A (preferida HD): mnemonic → deriva Cartera A
MASTER_MNEMONIC=word1 word2 ... word12or24
WALLETA_PUBKEY=YourWalletAPublicKeyHere

# Opción B (alternativa): secret key directa (JSON 64 bytes o base58)
# WALLETA_PRIVATE_KEY=[1,2,3,...]

WALLETB_PUBKEY=YourVaultBPublicKeyHere

# Paso 1 B0 — liquidez de nacimiento y MC
MIN_POOL_SOL=2.0
MIN_MC_USD=400
MAX_MC_USD=250000

# Paso 2 radar — compras orgánicas y tope 4 min
MIN_TX_COUNT=3
RADAR_MAX_MS=240000

# Paso 3 salida
TAKE_PROFIT_PCT=30
TRAILING_STOP_PCT=8

# true solo cuando quieras compras reales
LIVE_TRADING=false

# Opcional: Jupiter Pro
# JUPITER_API_KEY=
