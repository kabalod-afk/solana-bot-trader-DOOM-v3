# === Obligatorio: Helius ===
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=TU_HELIUS_KEY
SOLANA_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=TU_HELIUS_KEY

# === Obligatorio: Telegram ===
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# === Obligatorio: Cartera única (la que firma — la del mnemonic) ===
MASTER_MNEMONIC=word1 word2 ... word12or24
# Debe ser la pubkey que sale del mnemonic (en tu caso Hbuybv5N…, no la vault 9saHM5d…)
WALLETA_PUBKEY=Hbuybv5NqmmofeGMSvAyeK6bXiC6vLHKtKv6grkUfmJi
# Opcional: si B NO sale del mnemonic, no la pongas (o pon WALLETB_PRIVATE_KEY)
# WALLETB_PUBKEY=
# WALLETB_PRIVATE_KEY=

# === Jito (bundle de compra/venta) ===
JITO_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# === Fuente de candidatos ===
# phantom_launches = columna Launches de Phantom Terminal (New/Migrating/Migrated), sin firehose de creates
# helius_creates   = comportamiento v3 original (logsSubscribe Pump/Raydium)
# both             = las dos fuentes
CANDIDATE_SOURCE=phantom_launches
# Columnas Phantom: new | migrating | migrated (coma-separadas). Default: new
PHANTOM_LAUNCH_COLUMNS=new
PHANTOM_LAUNCH_POLL_MS=4000
# true = también dispara B0 sobre el tablero ya visible al arrancar (útil en dry-run)
PHANTOM_SEED_EXISTING=false

# === Operador (MC, radar, salida) ===
# Pool mínimo B0: MIN_POOL_SOL en .env pisa helios_brain.json (default JSON = 1 SOL)
MIN_POOL_SOL=1
MIN_MC_USD=400
MAX_MC_USD=250000
MIN_TX_COUNT=3
RADAR_MAX_MS=210000
POSITION_MAX_MS=240000
TAKE_PROFIT_PCT=35
TRAILING_STOP_PCT=10
# Tamaño de compra base (Cartera B). Alta convicción ≈ ×1.5
ENTRY_SIZE_SOL=0.4

# devnet = papel (B0 + radar + Telegram, SIN gastar SOL)
# mainnet = compras reales con Cartera B
NETWORK=devnet

# Opcional: Jupiter Pro. Si no, lite-api.jup.ag (solo si JSON no tiene memoria del deployer)
# JUPITER_API_KEY=
